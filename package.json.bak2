{
  "name": "zyweb",
  "version": "3.4.1-beta20251005",
  "description": "Web version of zyfun client",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hiram-Wong/ZyPlayer.git"
  },
  "keywords": [
    "zyplayer",
    "zyfun",
    "web-app",
    "video"
  ],
  "author": {
    "name": "Hiram-Wong",
    "email": "admin@catni.cn"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Hiram-Wong/ZyPlayer/issues"
  },
  "homepage": "https://github.com/Hiram-Wong/ZyPlayer#readme",
  "scripts": {
    "dev:web": "/workspace/cleanup.sh && node --max-old-space-size=300 ./node_modules/.bin/vite",
    "build:web": "/workspace/cleanup.sh && node --max-old-space-size=30 --no-warnings ./node_modules/.bin/vite build",
    "build:web:app": "/workspace/cleanup.sh && node --max-old-space-size=150 --no-warnings ./node_modules/.bin/vite build --config vite.web-app.config.ts",
    "build:web:film": "/workspace/cleanup.sh && node --max-old-space-size=30 --no-warnings ./node_modules/.bin/vite build --config vite.film.config.ts",
    "build:web:iptv": "/workspace/cleanup.sh && node --max-old-space-size=30 --no-warnings ./node_modules/.bin/vite build --config vite.iptv.config.ts",
    "build:web:drive": "/workspace/cleanup.sh && node --max-old-space-size=30 --no-warnings ./node_modules/.bin/vite build --config vite.drive.config.ts",
    "build:web:play": "/workspace/cleanup.sh && node --max-old-space-size=30 --no-warnings ./node_modules/.bin/vite build --config vite.play.config.ts",
    "build:web:analyze": "/workspace/cleanup.sh && node --max-old-space-size=30 --no-warnings ./node_modules/.bin/vite build --config vite.analyze.config.ts",
    "build:web:chase": "/workspace/cleanup.sh && node --max-old-space-size=30 --no-warnings ./node_modules/.bin/vite build --config vite.chase.config.ts",
    "build:web:setting": "/workspace/cleanup.sh && node --max-old-space-size=30 --no-warnings ./node_modules/.bin/vite build --config vite.setting.config.ts",
    "build:web:lab": "/workspace/cleanup.sh && node --max-old-space-size=30 --no-warnings ./node_modules/.bin/vite build --config vite.lab.config.ts",
    "build:web:test": "/workspace/cleanup.sh && node --max-old-space-size=30 --no-warnings ./node_modules/.bin/vite build --config vite.test.config.ts",
    "build:web:consistent": "/workspace/cleanup.sh && ./build-consistent-ui.sh",
    "build:web:components": "/workspace/cleanup.sh && bash scripts/build-all-dynamic-memory.sh",
    "build:web:components:esbuild": "node build-components-esbuild.js",
    "build:web:combine": "/workspace/cleanup.sh && ./combine-build-results.sh",
    "build:web:complete": "/workspace/cleanup.sh && ./build-complete-workflow.sh",
    "build:web:fine": "/workspace/cleanup.sh && ./build-fine-components.sh",
    "build:web:assembly": "./build-assembly-frontend.sh",
    "dev:server": "node --max-old-space-size=50 src/main/core/server/index.ts",
    "dev:server:web": "npx ts-node --transpile-only src/main/core/server/index.web.ts",
    "build:web:simple-test": "/workspace/cleanup.sh && node --max-old-space-size=10 --no-warnings ./node_modules/.bin/vite build --config vite.simple-test.config.ts",
    "build:web:code-editor": "/workspace/cleanup.sh && node --max-old-space-size=60 --no-warnings ./node_modules/.bin/vite build --config vite.code-editor.config.ts",
    "build:web:static-filter": "/workspace/cleanup.sh && node --max-old-space-size=30 --no-warnings ./node_modules/.bin/vite build --config vite.static-filter.config.ts",
    "build:web:aside-film": "/workspace/cleanup.sh && node --max-old-space-size=30 --no-warnings ./node_modules/.bin/vite build --config vite.aside-film.config.ts",
    "build:web:detail": "/workspace/cleanup.sh && node --max-old-space-size=30 --no-warnings ./node_modules/.bin/vite build --config vite.detail.config.ts",
    "build:web:dialog-data": "/workspace/cleanup.sh && node --max-old-space-size=30 --no-warnings ./node_modules/.bin/vite build --config vite.dialog-data.config.ts",
    "build:web:plugin-center": "/workspace/cleanup.sh && node --max-old-space-size=30 --no-warnings ./node_modules/.bin/vite build --config vite-configs-fine/vite.plugin-center.config.ts",
    "build:web:ai-brain": "/workspace/cleanup.sh && node --max-old-space-size=30 --no-warnings ./node_modules/.bin/vite build --config vite.ai-brain.config.ts",
    "build:web:binge": "/workspace/cleanup.sh && node --max-old-space-size=30 --no-warnings ./node_modules/.bin/vite build --config vite.binge.config.ts",
    "build:web:history": "/workspace/cleanup.sh && node --max-old-space-size=30 --no-warnings ./node_modules/.bin/vite build --config vite.history.config.ts",
    "build:web:aside-iptv": "/workspace/cleanup.sh && node --max-old-space-size=30 --no-warnings ./node_modules/.bin/vite build --config vite.aside-iptv.config.ts",
    "build:web:aside-analyze": "/workspace/cleanup.sh && node --max-old-space-size=30 --no-warnings ./node_modules/.bin/vite build --config vite.aside-analyze.config.ts",
    "build:web:aside-drive": "/workspace/cleanup.sh && node --max-old-space-size=30 --no-warnings ./node_modules/.bin/vite build --config vite.aside-drive.config.ts",
    "build:web:dialog-search": "/workspace/cleanup.sh && node --max-old-space-size=30 --no-warnings ./node_modules/.bin/vite build --config vite.dialog-search.config.ts",
    "build:web:sniffer-play": "/workspace/cleanup.sh && node --max-old-space-size=30 --no-warnings ./node_modules/.bin/vite build --config vite.sniffer-play.config.ts",
    "build:web:req-html": "/workspace/cleanup.sh && node --max-old-space-size=30 --no-warnings ./node_modules/.bin/vite build --config vite.req-html.config.ts",
    "build:web:file-diff": "/workspace/cleanup.sh && node --max-old-space-size=30 --no-warnings ./node_modules/.bin/vite build --config vite.file-diff.config.ts",
    "build:web:data-crypto": "/workspace/cleanup.sh && node --max-old-space-size=30 --no-warnings ./node_modules/.bin/vite build --config vite.data-crypto.config.ts",
    "build:web:markdown-render": "/workspace/cleanup.sh && node --max-old-space-size=30 --no-warnings ./node_modules/.bin/vite build --config vite-configs-fine/vite.markdown-render.config.ts",
    "build:web:share-popup": "/workspace/cleanup.sh && node --max-old-space-size=60 --no-warnings ./node_modules/.bin/vite build --config vite-configs-fine/vite.share-popup.config.ts",
    "build:web:shortcut-input": "/workspace/cleanup.sh && node --max-old-space-size=60 --no-warnings ./node_modules/.bin/vite build --config vite-configs-fine/vite.shortcut-input.config.ts",
    "build:web:split": "/workspace/cleanup.sh && node --max-old-space-size=60 --no-warnings ./node_modules/.bin/vite build --config vite-configs-fine/vite.split.config.ts",
    "build:web:tag-nav": "/workspace/cleanup.sh && node --max-old-space-size=30 --no-warnings ./node_modules/.bin/vite build --config vite-configs-fine/vite.tag-nav.config.ts",
    "build:web:terminal": "/workspace/cleanup.sh && node --max-old-space-size=60 --no-warnings ./node_modules/.bin/vite build --config vite-configs-fine/vite.terminal.config.ts",
    "build:web:SharedButton": "/workspace/cleanup.sh && node --max-old-space-size=30 --no-warnings ./node_modules/.bin/vite build --config vite-configs-fine/vite.SharedButton.config.ts",
    "build:web:SharedCard": "/workspace/cleanup.sh && node --max-old-space-size=30 --no-warnings ./node_modules/.bin/vite build --config vite-configs-fine/vite.SharedCard.config.ts",
    "build:web:dynamic-memory": "bash scripts/build-all-dynamic-memory.sh"
  },
  "dependencies": {
    "@imengyu/vue3-context-menu": "^1.5.2",
    "@microsoft/fetch-event-source": "^2.0.1",
    "@vueuse/core": "^13.9.0",
    "axios": "^1.9.0",
    "cheerio": "^1.1.2",
    "crypto-js": "^4.2.0",
    "flv.js": "^1.6.2",
    "hls.js": "^1.6.13",
    "iconv-lite": "^0.7.0",
    "jsonpath-plus": "^10.3.0",
    "lodash-es": "^4.17.21",
    "moment": "^2.30.1",
    "mpegts.js": "^1.8.0",
    "p-queue": "^9.0.0",
    "pako": "^2.1.0",
    "pinia": "^3.0.3",
    "pinia-plugin-persistedstate": "^4.5.0",
    "shaka-player": "^4.16.3",
    "sm-crypto": "^0.3.13",
    "splitpanes": "^4.0.4",
    "tdesign-icons-vue-next": "^0.4.1",
    "tdesign-vue-next": "^1.17.0",
    "uuid": "^13.0.0",
    "v3-infinite-loading": "^1.3.2",
    "vue": "^3.5.16",
    "vue-i18n": "^11.1.12",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitejs/plugin-vue-jsx": "^5.1.1",
    "less": "^4.4.1",
    "terser": "^5.44.0",
    "typescript": "^5.9.3",
    "vite": "^6.3.5"
  },
  "engines": {
    "node": "20 || >= 22"
  }
}