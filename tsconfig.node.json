{
  "include": [
    "electron.vite.config.*",
    "src/main/**/*",
    "src/preload/**/*",
    "test-imports.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "types": [
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@main/*": [
        "src/main/*"
      ],
      "@preload/*": [
        "src/preload/*"
      ],
      "@main/core/db/service": [
        "src/main/core/db/service/index.web"
      ],
      "@main/core/db/service/*": [
        "src/main/core/db/service/*"
      ],
      "@main/utils/tool": [
        "src/main/utils/tool/index.web"
      ],
      "@main/utils/tool/*": [
        "src/main/utils/tool/*"
      ],
      "@main/utils/lrucache": [
        "src/main/utils/lrucache/index.web"
      ],
      "@main/utils/lrucache/*": [
        "src/main/utils/lrucache/*"
      ],
      "@main/utils/hiker/file": [
        "src/main/utils/hiker/file.web"
      ],
      "@main/utils/hiker/file/*": [
        "src/main/utils/hiker/file.*"
      ],
      "@main/utils/hiker/htmlParser": [
        "src/main/utils/hiker/htmlParser.web"
      ],
      "@main/utils/hiker/htmlParser/*": [
        "src/main/utils/hiker/htmlParser.*"
      ],
      "@main/utils/hiker/path": [
        "src/main/utils/hiker/path.web"
      ],
      "@main/utils/hiker/path/*": [
        "src/main/utils/hiker/path.*"
      ],
      "@main/core/db/common/client": [
        "src/main/core/db/common/client.web"
      ],
      "@main/core/db/common/client/*": [
        "src/main/core/db/common/client.*"
      ],
      "@main/core/db/common": [
        "src/main/core/db/common/index.web"
      ],
      "@main/core/db/common/*": [
        "src/main/core/db/common/*"
      ]
    },
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  }
}